s[\"MAE\"],\n","            \"independent_RPIQ\": val_metrics[\"RPIQ\"],\n","            \"independent_Observed_Q25\": val_metrics[\"Observed_Q25\"],\n","            \"independent_Observed_Q75\": val_metrics[\"Observed_Q75\"],\n","            \"independent_Observed_IQR\": val_metrics[\"Observed_IQR\"],\n","        })\n","\n","        step(\n","            f\"{name}: independent metrics calculated | \"\n","            f\"R2={val_metrics['R2']:.5f}, \"\n","            f\"RMSE={val_metrics['RMSE']:.5f}, \"\n","            f\"MAE={val_metrics['MAE']:.5f}, \"\n","            f\"RPIQ={val_metrics['RPIQ']:.5f}\"\n","        )\n","\n","        joblib.dump(\n","            {\n","                \"model\": final_model,\n","                \"algorithm\": name,\n","                \"target_column\": TARGET_COLUMN,\n","                \"selected_features\": selected_features,\n","                \"best_parameters\": best_parameters,\n","                \"selection_rule\": \"lowest 10-fold spatial-CV RMSE\",\n","                \"fixed_spatial_folds\": N_SPATIAL_FOLDS,\n","                \"spatial_block_size_m\": SPATIAL_BLOCK_SIZE_M,\n","                \"target_crs\": TARGET_CRS,\n","                \"development_OOF_metrics\": oof_metrics,\n","                \"independent_validation_metrics\": val_metrics,\n","            },\n","            MODEL_OUTPUTS[name][\"model\"],\n","        )\n","        step(\n","            f\"{name}: saved final model to \"\n","            f\"{MODEL_OUTPUTS[name]['model']}\"\n","        )\n","        step(\n","            f\"Overall workflow progress: {name} completed \"\n","            f\"({algorithm_number}/{total_algorithms}).\"\n","        )\n","\n","        print(\"\\n\" + \"-\" * 110)\n","        print(f\"{name} BEST MODEL\")\n","        print(\"-\" * 110)\n","        print(f\"Best parameters: {best_parameters}\")\n","        print(\n","            \"Development OOF: \"\n","            f\"R2={oof_metrics['R2']:.6f}, \"\n","            f\"R