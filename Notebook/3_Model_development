el_development/Dataset-II/GTB/best_model.joblib\n","\n","CART\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-II/CART/grid_search_all_results.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-II/CART/best_10fold_metrics.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-II/CART/best_model.joblib\n","\n","Overall summary\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-II/independent_validation_summary.csv\n"]}]},{"cell_type":"markdown","source":["# Independent Accuracy Assessment"],"metadata":{"id":"DgDIbS8kze6C"}},{"cell_type":"code","source":["# Optional Colab installation (run once if required):\n","# !pip install -q geopandas pyogrio scikit-learn joblib\n","\n","\"\"\"\n","Independent validation accuracy assessment for Dataset-II SOC models.\n","\n","This script:\n","1. Loads the independent validation GeoPackage.\n","2. Loads the fitted RF, GTB, and CART .joblib files.\n","3. Reads the exact selected-feature list stored in each model file.\n","4. Predicts SOC for the independent validation observations.\n","5. Calculates R2, RMSE, MAE, and RPIQ.\n","6. Saves one CSV containing only the independent validation results.\n","\n","No model training, cross-validation, grid search, or raster prediction is run.\n","\"\"\"\n","\n","from pathlib import Path\n","\n","import geopandas as gpd\n","import joblib\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.metrics import (\n","    mean_absolute_error,\n","    mean_squared_error,\n","    r2_score,\n",")\n","\n","\n","# ============================================================\n","# USER SETTINGS\n","# ============================================================\n","\n","INDEPENDENT_VALIDATION_GPKG = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/1_Feature_Selection/Split_features/LUCAS_samples_GSE_validation.gpkg\"\n",")\n","\n","TARGET_COLUMN = \"OC\"\n","\n","MODEL_FILES = {\n","    \"RF\": (\n","        \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","        \"1.Final_SOC_estimation/2.Model_development/Dataset-II/\"\n","        \"RF/best_model.joblib\"\n","    ),\n","    \"GTB\": (\n","        \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","        \"1.Final_SOC_estimation/2.Model_development/Dataset-II/\"\n","        \"GTB/best_model.joblib\"\n","    ),\n","    \"CART\": (\n","        \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","        \"1.Final_SOC_estimation/2.Model_development/Dataset-II/\"\n","        \"CART/best_model.joblib\"\n","    ),\n","}\n","\n","OUTPUT_CSV = Path(\n","    \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","    \"1.Final_SOC_estimation/2.Model_development/Dataset-II/\"\n","    \"independent_validation_accuracy_assessment.csv\"\n",")\n","\n","\n","# ============================================================\n","# HELPERS\n","# ============================================================\n","\n","def build_case_insensitive_lookup(columns):\n","    \"\"\"Map lowercase field names to their original names.\"\"\"\n","    lookup = {}\n","\n","    for column in columns:\n","        key = str(column).strip().casefold()\n","\n","        if key in lookup:\n","            raise ValueError(\n","                \"Duplicate fields were found under case-insensitive \"\n","                f\"matching: '{lookup[key]}' and '{column}'.\"\n","            )\n","\n","        lookup[key] = column\n","\n","    return lookup\n","\n","\n","def standardize_required_columns(gdf, required_columns, dataset_name):\n","    \"\"\"Align required field names case-insensitively.\"\"\"\n","    lookup = build_case_insensitive_lookup(gdf.columns)\n","    rename_map = {}\n","    missing = []\n","\n","    for required_column in required_columns:\n","        key = str(required_column).strip().casefold()\n","\n","        if key not in lookup:\n","            missing.append(required_column)\n","            continue\n","\n","        actual_column = lookup[key]\n","\n","        if actual_column != required_column:\n","            rename_map[actual_column] = required_column\n","\n","    if missing:\n","        raise ValueError(\n","            f\"{dataset_name} is missing required fields:\\n\"\n","            + \"\\n\".join(f\"  - {field}\" for field in missing)\n","        )\n","\n","    if rename_map:\n","        gdf = gdf.rename(columns=rename_map)\n","\n","    return gdf\n","\n","\n","def regression_metrics(y_true, y_pred):\n","    \"\"\"Calculate independent-validation R2, RMSE, MAE, and RPIQ.\"\"\"\n","    y_true = np.asarray(y_true, dtype=np.float64)\n","    y_pred = np.asarray(y_pred, dtype=np.float64)\n","\n","    rmse = float(np.sqrt(mean_squared_error(y_true, y_pred)))\n","    mae = float(mean_absolute_error(y_true, y_pred))\n","\n","    if len(y_true) >= 2 and np.var(y_true) > 0:\n","        r2 = float(r2_score(y_true, y_pred))\n","    else:\n","        r2 = np.nan\n","\n","    q25, q75 = np.percentile(y_true, [25, 75])\n","    iqr = float(q75 - q25)\n","    rpiq = float(iqr / rmse) if rmse > 0 else np.nan\n","\n","    residuals = y_true - y_pred\n","\n","    return {\n","        \"R2\": r2,\n","        \"RMSE\": rmse,\n","        \"MAE\": mae,\n","        \"RPIQ\": rpiq,\n","        \"Observed_Q25\": float(q25),\n","        \"Observed_Q75\": float(q75),\n","        \"Observed_IQR\": iqr,\n","        \"Mean_Residual\": float(np.mean(residuals)),\n","    }\n","\n","\n","def extract_model_and_features(saved_object, algorithm):\n","    \"\"\"Extract the fitted estimator and selected-feature list.\"\"\"\n","    if not isinstance(saved_object, dict):\n","        raise TypeError(\n","            f\"{algorithm}: the joblib file does not contain the expected \"\n","            \"metadata dictionary.\"\n","        )\n","\n","    if \"model\" not in saved_object:\n","        raise KeyError(\n","            f\"{algorithm}: key 'model' was not found in the joblib file.\"\n","        )\n","\n","    if \"selected_features\" not in saved_object:\n","        raise KeyError(\n","            f\"{algorithm}: key 'selected_features' was not found in the \"\n","            \"joblib file.\"\n","        )\n","\n","    model = saved_object[\"model\"]\n","    selected_features = list(saved_object[\"selected_features\"])\n","\n","    if not selected_features:\n","        raise ValueError(\n","            f\"{algorithm}: the stored selected-feature list is empty.\"\n","        )\n","\n","    return model, selected_features\n","\n","\n","# ============================================================\n","# MAIN\n","# ============================================================\n","\n","def main():\n","    validation_path = Path(INDEPENDENT_VALIDATION_GPKG)\n","\n","    if not validation_path.exists():\n","        raise FileNotFoundError(\n","            \"Independent validation GeoPackage was not found:\\n\"\n","            f\"{validation_path}\"\n","        )\n","\n","    validation_gdf = gpd.read_file(validation_path)\n","\n","    if validation_gdf.empty:\n","        raise ValueError(\n","            \"The independent validation dataset contains no observations.\"\n","        )\n","\n","    if validation_gdf.geometry.name in validation_gdf.columns:\n","        valid_geometry = (\n","            validation_gdf.geometry.notna()\n","            & (~validation_gdf.geometry.is_empty)\n","        )\n","\n","        removed_geometry = int((~valid_geometry).sum())\n","\n","        if removed_geometry > 0:\n","            print(\n","                f\"Removed {removed_geometry} observations with missing \"\n","                \"or empty geometry.\"\n","            )\n","\n","        validation_gdf = validation_gdf.loc[valid_geometry].copy()\n","\n","    results = []\n","\n","    print(\"=\" * 100)\n","    print(\"INDEPENDENT VALIDATION ACCURACY ASSESSMENT\")\n","    print(\"=\" * 100)\n","    print(f\"Validation dataset: {INDEPENDENT_VALIDATION_GPKG}\")\n","    print(f\"Validation observations: {len(validation_gdf):,}\")\n","\n","    for algorithm, model_path_text in MODEL_FILES.items():\n","        print(\"\\n\" + \"-\" * 100)\n","        print(algorithm)\n","        print(\"-\" * 100)\n","\n","        model_path = Path(model_path_text)\n","\n","        if not model_path.exists():\n","            raise FileNotFoundError(\n","                f\"{algorithm} model file was not found:\\n{model_path}\"\n","            )\n","\n","        saved_object = joblib.load(model_path)\n","        model, selected_features = extract_model_and_features(\n","            saved_object,\n","            algorithm,\n","        )\n","\n","        required_columns = [TARGET_COLUMN, *selected_features]\n","\n","        model_validation = standardize_required_columns(\n","            validation_gdf.copy(),\n","            required_columns,\n","            \"Independent validation dataset\",\n","        )\n","\n","        for column in required_columns:\n","            model_validation[column] = pd.to_numeric(\n","                model_validation[column],\n","                errors=\"coerce\",\n","            )\n","\n","        model_validation[required_columns] = (\n","            model_validation[required_columns]\n","            .replace([np.inf, -np.inf], np.nan)\n","        )\n","\n","        rows_before = len(model_validation)\n","        model_validation = model_validation.dropna(\n","            subset=required_columns\n","        ).copy()\n","        rows_removed = rows_before - len(model_validation)\n","\n","        if model_validation.empty:\n","            raise ValueError(\n","                f\"{algorithm}: no complete independent validation \"\n","                \"observations remain.\"\n","            )\n","\n","        X_validation = model_validation[selected_features].copy()\n","        y_observed = model_validation[TARGET_COLUMN].to_numpy(\n","            dtype=np.float64\n","        )\n","        y_predicted = model.predict(X_validation)\n","\n","        metrics = regression_metrics(y_observed, y_predicted)\n","\n","        results.append({\n","            \"algorithm\": algorithm,\n","            \"n_independent_validation\": len(y_observed),\n","            \"n_removed_missing_values\": rows_removed,\n","            \"n_selected_features\": len(selected_features),\n","            **metrics,\n","        })\n","\n","        print(\n","            f\"Observations used: {len(y_observed):,}\\n\"\n","            f\"Selected features: {len(selected_features):,}\\n\"\n","            f\"R2:   {metrics['R2']:.6f}\\n\"\n","            f\"RMSE: {metrics['RMSE']:.6f}\\n\"\n","            f\"MAE:  {metrics['MAE']:.6f}\\n\"\n","            f\"RPIQ: {metrics['RPIQ']:.6f}\"\n","        )\n","\n","    results_df = pd.DataFrame(results)\n","\n","    results_df = results_df.sort_values(\n","        by=[\"R2\", \"RMSE\", \"MAE\"],\n","        ascending=[False, True, True],\n","    ).reset_index(drop=True)\n","\n","    results_df.insert(\n","        0,\n","        \"independent_validation_rank\",\n","        np.arange(1, len(results_df) + 1),\n","    )\n","\n","    OUTPUT_CSV.parent.mkdir(parents=True, exist_ok=True)\n","    results_df.to_csv(OUTPUT_CSV, index=False)\n","\n","    print(\"\\n\" + \"=\" * 100)\n","    print(\"FINAL INDEPENDENT VALIDATION RESULTS\")\n","    print(\"=\" * 100)\n","\n","    with pd.option_context(\n","        \"display.max_columns\", None,\n","        \"display.width\", 220,\n","    ):\n","        print(results_df.to_string(index=False))\n","\n","    print(\"\\nSaved CSV:\")\n","    print(OUTPUT_CSV)\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4osP_MwGzkLv","executionInfo":{"status":"ok","timestamp":1785382864977,"user_tz":-300,"elapsed":1815,"user":{"displayName":"ABRAN IDREES","userId":"09950704276075396995"}},"outputId":"d7da06e9-050b-452b-c737-92c686881284"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["====================================================================================================\n","INDEPENDENT VALIDATION ACCURACY ASSESSMENT\n","====================================================================================================\n","Validation dataset: /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/1_Feature_Selection/Split_features/LUCAS_samples_GSE_validation.gpkg\n","Validation observations: 43\n","\n","----------------------------------------------------------------------------------------------------\n","RF\n","----------------------------------------------------------------------------------------------------\n","Observations used: 43\n","Selected features: 33\n","R2:   0.440370\n","RMSE: 19.890746\n","MAE:  15.500227\n","RPIQ: 1.181454\n","\n","----------------------------------------------------------------------------------------------------\n","GTB\n","----------------------------------------------------------------------------------------------------\n","Observations used: 43\n","Selected features: 33\n","R2:   0.479565\n","RMSE: 19.181557\n","MAE:  13.508115\n","RPIQ: 1.225135\n","\n","----------------------------------------------------------------------------------------------------\n","CART\n","----------------------------------------------------------------------------------------------------\n","Observations used: 43\n","Selected features: 33\n","R2:   0.409030\n","RMSE: 20.440123\n","MAE:  14.843371\n","RPIQ: 1.149700\n","\n","====================================================================================================\n","FINAL INDEPENDENT VALIDATION RESULTS\n","====================================================================================================\n"," independent_validation_rank algorithm  n_independent_validation  n_removed_missing_values  n_selected_features       R2      RMSE       MAE     RPIQ  Observed_Q25  Observed_Q75  Observed_IQR  Mean_Residual\n","                           1       GTB                        43                         0                   33 0.479565 19.181557 13.508115 1.225135           8.2          31.7          23.5      -1.251840\n","                           2        RF                        43                         0                   33 0.440370 19.890746 15.500227 1.181454           8.2          31.7          23.5      -3.089010\n","                           3      CART                        43                         0                   33 0.409030 20.440123 14.843371 1.149700           8.2          31.7          23.5      -2.861036\n","\n","Saved CSV:\n","/content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-II/independent_validation_accuracy_assessment.csv\n"]}]},{"cell_type":"markdown","source":["# Prediction of map"],"metadata":{"id":"aCLYmAPqafM5"}},{"cell_type":"code","source":["# ============================================================\n","# WALL-TO-WALL SOC PREDICTION\n","# Mainland Portugal\n","# Dataset-II | Random Forest | 33 GSE predictors\n","#\n","# IMPORTANT IMPROVEMENTS\n","# ------------------------------------------------------------\n","# 1. Reads the feature order expected by the trained model.\n","# 2. Reads raster band names from metadata.\n","# 3. Automatically reorders raster bands into MODEL order.\n","# 4. Uses ONLY the same 33 selected predictors.\n","# 5. Processes raster window-by-window.\n","# 6. Predicts in smaller pixel batches to control RAM.\n","# 7. Writes ONE final mainland Portugal SOC GeoTIFF.\n","# 8. Uses a SEPARATE .json checkpoint.\n","# 9. Can safely resume after interruption.\n","# ============================================================\n","\n","\n","# ============================================================\n","# 1. IMPORTS\n","# ============================================================\n","\n","import gc\n","import json\n","import math\n","import os\n","import time\n","import warnings\n","from pathlib import Path\n","\n","import joblib\n","import numpy as np\n","import pandas as pd\n","import rasterio\n","\n","from rasterio.windows import Window\n","from rasterio.errors import RasterioIOError\n","\n","\n","# ============================================================\n","# 2. USER SETTINGS\n","# ============================================================\n","\n","# ------------------------------------------------------------\n","# 33-band mainland Portugal raster/VRT\n","# ------------------------------------------------------------\n","\n","RASTER_PATH = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","    \"1.Final_SOC_estimation/\"\n","    \"SOC_GEE_exports/\"\n","    \"GSE_2018_Imagery_mosaic/\"\n","    \"GSE_2018_selected_33_bands_block_mosaic.vrt\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Final trained Dataset-II RF model\n","# ------------------------------------------------------------\n","\n","MODEL_PATH = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","    \"1.Final_SOC_estimation/\"\n","    \"2.Model_development/\"\n","    \"Dataset-II/\"\n","    \"RF/\"\n","    \"best_model.joblib\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Final SOC map\n","# ------------------------------------------------------------\n","\n","OUTPUT_RASTER = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","    \"1.Final_SOC_estimation/\"\n","    \"3.Final_SOC_Maps/\"\n","    \"SOC_DatasetII_RF_Mainland_Portugal_2018.tif\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# IMPORTANT:\n","# Separate JSON checkpoint\n","# ------------------------------------------------------------\n","\n","CHECKPOINT_PATH = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/\"\n","    \"1.Final_SOC_estimation/\"\n","    \"3.Final_SOC_Maps/\"\n","    \"SOC_DatasetII_RF_Mainland_Portugal_2018_checkpoint.json\"\n",")\n","\n","\n","# ============================================================\n","# 3. KNOWN 33 RASTER FEATURES\n","#\n","# This represents the expected physical raster feature set.\n","#\n","# The MODEL may expect these same predictors in another order.\n","# The code automatically handles that.\n","# ============================================================\n","\n","RASTER_FEATURES = [\n","    \"A01\",\n","    \"A05\",\n","    \"A06\",\n","    \"A07\",\n","    \"A08\",\n","    \"A10\",\n","    \"A13\",\n","    \"A14\",\n","    \"A16\",\n","    \"A19\",\n","    \"A21\",\n","    \"A23\",\n","    \"A26\",\n","    \"A27\",\n","    \"A30\",\n","    \"A31\",\n","    \"A33\",\n","    \"A34\",\n","    \"A35\",\n","    \"A37\",\n","    \"A38\",\n","    \"A39\",\n","    \"A40\",\n","    \"A41\",\n","    \"A45\",\n","    \"A48\",\n","    \"A49\",\n","    \"A50\",\n","    \"A51\",\n","    \"A53\",\n","    \"A54\",\n","    \"A56\",\n","    \"A62\",\n","]\n","\n","\n","N_FEATURES = len(RASTER_FEATURES)\n","\n","\n","if N_FEATURES != 33:\n","\n","    raise ValueError(\n","        f\"Expected 33 selected predictors, \"\n","        f\"found {N_FEATURES}.\"\n","    )\n","\n","\n","# ============================================================\n","# 4. PROCESSING SETTINGS\n","# ============================================================\n","\n","# Internal raster window\n","WINDOW_SIZE = 512\n","\n","\n","# Maximum number of pixels passed to model.predict()\n","# in one call.\n","PREDICTION_BATCH_SIZE = 100_000\n","\n","\n","OUTPUT_NODATA = -9999.0\n","\n","\n","CHECKPOINT_EVERY = 10\n","\n","\n","# Resume interrupted prediction\n","RESUME = True\n","\n","\n","# Set True only if you intentionally want to restart\n","# from window 1.\n","OVERWRITE_OUTPUT = False\n","\n","\n","# Retry raster reads in case Google Drive temporarily fails\n","READ_RETRIES = 3\n","\n","READ_RETRY_SECONDS = 3\n","\n","\n","# ============================================================\n","# 5. BASIC SAFETY\n","# ============================================================\n","\n","if os.path.abspath(\n","    OUTPUT_RASTER\n",") == os.path.abspath(\n","    CHECKPOINT_PATH\n","):\n","\n","    raise ValueError(\n","        \"\\nOUTPUT_RASTER and CHECKPOINT_PATH \"\n","        \"cannot be the same file.\"\n","    )\n","\n","\n","Path(\n","    OUTPUT_RASTER\n",").parent.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","Path(\n","    CHECKPOINT_PATH\n",").parent.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","if not os.path.exists(\n","    RASTER_PATH\n","):\n","\n","    raise FileNotFoundError(\n","        f\"Raster not found:\\n{RASTER_PATH}\"\n","    )\n","\n","\n","if not os.path.exists(\n","    MODEL_PATH\n","):\n","\n","    raise FileNotFoundError(\n","        f\"Model not found:\\n{MODEL_PATH}\"\n","    )\n","\n","\n","# ============================================================\n","# 6. LOAD MODEL\n","# ============================================================\n","\n","def load_saved_model(\n","    model_path\n","):\n","\n","    obj = joblib.load(\n","        model_path\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # Direct estimator\n","    # --------------------------------------------------------\n","\n","    if hasattr(\n","        obj,\n","        \"predict\"\n","    ):\n","\n","        return obj, {}\n","\n","\n","    # --------------------------------------------------------\n","    # Dictionary containing estimator\n","    # --------------------------------------------------------\n","\n","    if isinstance(\n","        obj,\n","        dict\n","    ):\n","\n","        possible_keys = [\n","            \"model\",\n","            \"best_model\",\n","            \"estimator\",\n","            \"best_estimator\",\n","            \"pipeline\",\n","        ]\n","\n","\n","        for key in possible_keys:\n","\n","            if (\n","                key in obj\n","                and hasattr(\n","                    obj[key],\n","                    \"predict\"\n","                )\n","            ):\n","\n","                print(\n","                    \"Model found inside joblib \"\n","                    f\"dictionary under key: '{key}'\"\n","                )\n","\n","                return (\n","                    obj[key],\n","                    obj,\n","                )\n","\n","\n","    raise TypeError(\n","        \"Could not find a model with predict() \"\n","        \"inside the joblib file.\"\n","    )\n","\n","\n","# ============================================================\n","# 7. GET MODEL FEATURE COUNT\n","# ============================================================\n","\n","def get_model_feature_count(\n","    model\n","):\n","\n","    if hasattr(\n","        model,\n","        \"n_features_in_\"\n","    ):\n","\n","        return int(\n","            model.n_features_in_\n","        )\n","\n","\n","    if hasattr(\n","        model,\n","        \"named_steps\"\n","    ):\n","\n","        for _, estimator in reversed(\n","            list(\n","                model.named_steps.items()\n","            )\n","        ):\n","\n","            if hasattr(\n","                estimator,\n","                \"n_features_in_\"\n","            ):\n","\n","                return int(\n","                    estimator.n_features_in_\n","                )\n","\n","\n","    return None\n","\n","\n","# ============================================================\n","# 8. DETERMINE EXACT MODEL FEATURE ORDER\n","#\n","# Priority:\n","#\n","# 1. model.feature_names_in_\n","# 2. selected_features stored in joblib dictionary\n","# 3. known raster order as last fallback\n","# ============================================================\n","\n","def determine_model_feature_order(\n","    model,\n","    metadata\n","):\n","\n","    estimator_features = None\n","\n","    metadata_features = None\n","\n","\n","    # --------------------------------------------------------\n","    # Strongest evidence:\n","    # sklearn feature_names_in_\n","    # --------------------------------------------------------\n","\n","    if hasattr(\n","        model,\n","        \"feature_names_in_\"\n","    ):\n","\n","        estimator_features = [\n","\n","            str(x).strip()\n","\n","            for x\n","            in model.feature_names_in_\n","\n","        ]\n","\n","\n","        print(\n","            \"\\nModel feature_names_in_ found.\"\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # Feature list saved alongside model\n","    # --------------------------------------------------------\n","\n","    for key in [\n","        \"selected_features\",\n","        \"feature_names\",\n","        \"features\",\n","    ]:\n","\n","        if key in metadata:\n","\n","            metadata_features = [\n","\n","                str(x).strip()\n","\n","                for x\n","                in metadata[key]\n","\n","            ]\n","\n","\n","            print(\n","                f\"Stored model feature sequence \"\n","                f\"found under metadata key: '{key}'\"\n","            )\n","\n","            break\n","\n","\n","    # --------------------------------------------------------\n","    # If BOTH exist, they should agree.\n","    # --------------------------------------------------------\n","\n","    if (\n","        estimator_features is not None\n","        and\n","        metadata_features is not None\n","    ):\n","\n","        if (\n","            estimator_features\n","            != metadata_features\n","        ):\n","\n","            raise ValueError(\n","                \"\\nSTOPPING.\\n\\n\"\n","                \"model.feature_names_in_ and the \"\n","                \"stored joblib feature sequence disagree.\\n\\n\"\n","                f\"feature_names_in_:\\n\"\n","                f\"{estimator_features}\\n\\n\"\n","                f\"stored metadata:\\n\"\n","                f\"{metadata_features}\"\n","            )\n","\n","\n","    # --------------------------------------------------------\n","    # Choose authoritative sequence\n","    # --------------------------------------------------------\n","\n","    if estimator_features is not None:\n","\n","        model_features = (\n","            estimator_features\n","        )\n","\n","\n","    elif metadata_features is not None:\n","\n","        model_features = (\n","            metadata_features\n","        )\n","\n","\n","        print(\n","            \"\\nNOTE:\"\n","            \"\\nThe model itself does not expose \"\n","            \"feature_names_in_.\"\n","            \"\\nUsing the feature sequence saved \"\n","            \"inside the joblib metadata.\"\n","        )\n","\n","\n","    else:\n","\n","        model_features = (\n","            RASTER_FEATURES.copy()\n","        )\n","\n","\n","        print(\n","            \"\\nWARNING:\"\n","            \"\\nNo model feature names were stored.\"\n","            \"\\nFalling back to the known raster \"\n","            \"feature sequence.\"\n","        )\n","\n","\n","    # ========================================================\n","    # VALIDATE MODEL FEATURE LIST\n","    # ========================================================\n","\n","    if len(\n","        model_features\n","    ) != N_FEATURES:\n","\n","        raise ValueError(\n","            f\"Model feature list has \"\n","            f\"{len(model_features)} variables; \"\n","            f\"expected {N_FEATURES}.\"\n","        )\n","\n","\n","    if len(\n","        set(model_features)\n","    ) != N_FEATURES:\n","\n","        raise ValueError(\n","            \"Duplicate predictor names exist \"\n","            \"in the model feature sequence.\"\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # Same predictors must be present\n","    # --------------------------------------------------------\n","\n","    missing = sorted(\n","        set(RASTER_FEATURES)\n","        - set(model_features)\n","    )\n","\n","\n","    extra = sorted(\n","        set(model_features)\n","        - set(RASTER_FEATURES)\n","    )\n","\n","\n","    if missing or extra:\n","\n","        raise ValueError(\n","            \"\\nMODEL AND RASTER DO NOT USE \"\n","            \"THE SAME FEATURE SET.\\n\\n\"\n","            f\"Missing from model:\\n{missing}\\n\\n\"\n","            f\"Extra in model:\\n{extra}\"\n","        )\n","\n","\n","    return model_features\n","\n","\n","# ============================================================\n","# 9. RESOLVE RASTER BAND NUMBERS\n","#\n","# Creates mapping:\n","#\n","# MODEL feature 1 -> correct physical raster band\n","# MODEL feature 2 -> correct physical raster band\n","# ...\n","#\n","# Example:\n","#\n","# A41 -> raster band 24\n","# A05 -> raster band 2\n","# A31 -> raster band 16\n","# ...\n","# ============================================================\n","\n","def resolve_raster_band_indices(\n","    src,\n","    model_feature_order\n","):\n","\n","    if src.count != N_FEATURES:\n","\n","        raise ValueError(\n","            f\"Raster contains {src.count} bands. \"\n","            f\"Expected exactly {N_FEATURES}.\"\n","        )\n","\n","\n","    raster_descriptions = [\n","\n","        (\n","            str(description).strip()\n","            if description is not None\n","            else None\n","        )\n","\n","        for description\n","        in src.descriptions\n","\n","    ]\n","\n","\n","    # ========================================================\n","    # BEST CASE:\n","    # Raster has valid feature names in metadata.\n","    # ========================================================\n","\n","    if all(\n","        description is not None\n","        for description\n","        in raster_descriptions\n","    ):\n","\n","        if len(\n","            set(raster_descriptions)\n","        ) != N_FEATURES:\n","\n","            raise ValueError(\n","                \"Raster contains duplicate band names.\"\n","            )\n","\n","\n","        missing = sorted(\n","            set(RASTER_FEATURES)\n","            - set(raster_descriptions)\n","        )\n","\n","\n","        extra = sorted(\n","            set(raster_descriptions)\n","            - set(RASTER_FEATURES)\n","        )\n","\n","\n","        if missing or extra:\n","\n","            raise ValueError(\n","                \"\\nRaster metadata does not contain \"\n","                \"the expected 33 predictor names.\\n\\n\"\n","                f\"Missing:\\n{missing}\\n\\n\"\n","                f\"Unexpected:\\n{extra}\"\n","            )\n","\n","\n","        raster_lookup = {\n","\n","            name: index\n","\n","            for index, name in enumerate(\n","                raster_descriptions,\n","                start=1,\n","            )\n","\n","        }\n","\n","\n","        band_indices = [\n","\n","            raster_lookup[\n","                feature\n","            ]\n","\n","            for feature\n","            in model_feature_order\n","\n","        ]\n","\n","\n","        print(\n","            \"\\n✓ Raster band names obtained \"\n","            \"from raster metadata.\"\n","        )\n","\n","\n","        return (\n","            band_indices,\n","            raster_descriptions,\n","        )\n","\n","\n","    # ========================================================\n","    # FALLBACK:\n","    #\n","    # Raster has exactly 33 bands but descriptions unavailable.\n","    #\n","    # Use previously verified physical sequence.\n","    # ========================================================\n","\n","    print(\n","        \"\\nWARNING:\"\n","        \"\\nRaster band descriptions are incomplete.\"\n","        \"\\nUsing the known verified physical \"\n","        \"RASTER_FEATURES sequence.\"\n","    )\n","\n","\n","    raster_lookup = {\n","\n","        feature: index\n","\n","        for index, feature in enumerate(\n","            RASTER_FEATURES,\n","            start=1,\n","        )\n","\n","    }\n","\n","\n","    band_indices = [\n","\n","        raster_lookup[\n","            feature\n","        ]\n","\n","        for feature\n","        in model_feature_order\n","\n","    ]\n","\n","\n","    return (\n","        band_indices,\n","        RASTER_FEATURES.copy(),\n","    )\n","\n","\n","# ============================================================\n","# 10. GENERATE WINDOWS\n","# ============================================================\n","\n","def generate_windows(\n","    width,\n","    height,\n","    block_size\n","):\n","\n","    for row_off in range(\n","        0,\n","        height,\n","        block_size\n","    ):\n","\n","        win_height = min(\n","            block_size,\n","            height - row_off\n","        )\n","\n","\n","        for col_off in range(\n","            0,\n","            width,\n","            block_size\n","        ):\n","\n","            win_width = min(\n","                block_size,\n","                width - col_off\n","            )\n","\n","\n","            yield Window(\n","                col_off=col_off,\n","                row_off=row_off,\n","                width=win_width,\n","                height=win_height,\n","            )\n","\n","\n","# ============================================================\n","# 11. CHECKPOINT\n","# ============================================================\n","\n","def save_checkpoint(\n","    next_window,\n","    total_windows,\n","    model_feature_order,\n","    raster_band_indices\n","):\n","\n","    checkpoint = {\n","\n","        \"next_window\":\n","            int(next_window),\n","\n","        \"total_windows\":\n","            int(total_windows),\n","\n","        \"window_size\":\n","            int(WINDOW_SIZE),\n","\n","        \"raster_path\":\n","            RASTER_PATH,\n","\n","        \"model_path\":\n","            MODEL_PATH,\n","\n","        \"output_raster\":\n","            OUTPUT_RASTER,\n","\n","        \"model_feature_order\":\n","            list(\n","                model_feature_order\n","            ),\n","\n","        \"raster_band_indices\":\n","            [\n","                int(x)\n","                for x\n","                in raster_band_indices\n","            ],\n","    }\n","\n","\n","    temporary_path = (\n","        CHECKPOINT_PATH\n","        + \".tmp\"\n","    )\n","\n","\n","    with open(\n","        temporary_path,\n","        \"w\"\n","    ) as file:\n","\n","        json.dump(\n","            checkpoint,\n","            file,\n","            indent=4,\n","        )\n","\n","\n","    # Replace ONLY the JSON checkpoint.\n","    os.replace(\n","        temporary_path,\n","        CHECKPOINT_PATH,\n","    )\n","\n","\n","def load_checkpoint():\n","\n","    if not os.path.exists(\n","        CHECKPOINT_PATH\n","    ):\n","\n","        return None\n","\n","\n","    try:\n","\n","        with open(\n","            CHECKPOINT_PATH,\n","            \"r\"\n","        ) as file:\n","\n","            return json.load(\n","                file\n","            )\n","\n","\n","    except Exception as error:\n","\n","        print(\n","            \"\\nWARNING:\"\n","            \"\\nCheckpoint could not be read.\"\n","            f\"\\n{error}\"\n","        )\n","\n","        return None\n","\n","\n","# ============================================================\n","# 12. TEST OUTPUT RASTER\n","# ============================================================\n","\n","def output_raster_is_valid(\n","    path\n","):\n","\n","    if not os.path.exists(\n","        path\n","    ):\n","\n","        return False\n","\n","\n","    try:\n","\n","        with rasterio.open(\n","            path\n","        ) as src:\n","\n","            return (\n","                src.count == 1\n","                and\n","                src.width > 0\n","                and\n","                src.height > 0\n","            )\n","\n","\n","    except Exception:\n","\n","        return False\n","\n","\n","# ============================================================\n","# 13. SAFE RASTER READ\n","#\n","# IMPORTANT:\n","# indexes are supplied in MODEL FEATURE ORDER.\n","# ============================================================\n","\n","def safe_read_window(\n","    src,\n","    band_indices,\n","    window\n","):\n","\n","    last_error = None\n","\n","\n","    for attempt in range(\n","        1,\n","        READ_RETRIES + 1\n","    ):\n","\n","        try:\n","\n","            data = src.read(\n","                indexes=band_indices,\n","                window=window,\n","                out_dtype=\"float32\",\n","                masked=False,\n","            )\n","\n","\n","            masks = src.read_masks(\n","                indexes=band_indices,\n","                window=window,\n","            )\n","\n","\n","            return (\n","                data,\n","                masks,\n","            )\n","\n","\n","        except RasterioIOError as error:\n","\n","            last_error = error\n","\n","\n","            print(\n","                \"\\n\\nRaster read failed.\"\n","            )\n","\n","            print(\n","                f\"Attempt \"\n","                f\"{attempt}/{READ_RETRIES}\"\n","            )\n","\n","            print(\n","                f\"Window: {window}\"\n","            )\n","\n","            print(\n","                f\"Error: {error}\"\n","            )\n","\n","\n","            if (\n","                attempt\n","                < READ_RETRIES\n","            ):\n","\n","                print(\n","                    f\"Retrying in \"\n","                    f\"{READ_RETRY_SECONDS} seconds...\"\n","                )\n","\n","                time.sleep(\n","                    READ_RETRY_SECONDS\n","                )\n","\n","\n","    raise RuntimeError(\n","        \"\\nRaster window could not be read \"\n","        f\"after {READ_RETRIES} attempts.\\n\\n\"\n","        f\"Window:\\n{window}\\n\\n\"\n","        f\"Original error:\\n{last_error}\"\n","    )\n","\n","\n","# ============================================================\n","# 14. PREDICT IN BATCHES\n","#\n","# Prevents model.predict() from receiving all ~262k pixels\n","# of a full 512 x 512 window simultaneously.\n","# ============================================================\n","\n","def predict_in_batches(\n","    model,\n","    X,\n","    model_feature_order\n","):\n","\n","    n_samples = X.shape[0]\n","\n","\n","    predictions = np.empty(\n","        n_samples,\n","        dtype=np.float32,\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # If sklearn remembers DataFrame feature names,\n","    # predict using a DataFrame with EXACT matching columns.\n","    # --------------------------------------------------------\n","\n","    model_has_feature_names = hasattr(\n","        model,\n","        \"feature_names_in_\"\n","    )\n","\n","\n","    for start in range(\n","        0,\n","        n_samples,\n","        PREDICTION_BATCH_SIZE\n","    ):\n","\n","        stop = min(\n","            start\n","            + PREDICTION_BATCH_SIZE,\n","            n_samples,\n","        )\n","\n","\n","        X_batch = X[\n","            start:stop\n","        ]\n","\n","\n","        if model_has_feature_names:\n","\n","            X_input = pd.DataFrame(\n","                X_batch,\n","                columns=model_feature_order,\n","            )\n","\n","\n","        else:\n","\n","            X_input = X_batch\n","\n","\n","        batch_prediction = model.predict(\n","            X_input\n","        )\n","\n","\n","        predictions[\n","            start:stop\n","        ] = np.asarray(\n","            batch_prediction,\n","            dtype=np.float32,\n","        ).reshape(-1)\n","\n","\n","    return predictions\n","\n","\n","# ============================================================\n","# 15. LOAD MODEL\n","# ============================================================\n","\n","print(\n","    \"=\" * 80\n",")\n","\n","print(\n","    \"LOADING SOC MODEL\"\n",")\n","\n","print(\n","    \"=\" * 80\n",")\n","\n","\n","model, model_metadata = (\n","    load_saved_model(\n","        MODEL_PATH\n","    )\n",")\n","\n","\n","print(\n","    \"\\nModel loaded successfully.\"\n",")\n","\n","print(\n","    f\"Model type: \"\n","    f\"{type(model)}\"\n",")\n","\n","\n","# ============================================================\n","# 16. FEATURE COUNT CHECK\n","# ============================================================\n","\n","model_n_features = (\n","    get_model_feature_count(\n","        model\n","    )\n",")\n","\n","\n","if model_n_features is not None:\n","\n","    print(\n","        f\"Model expected feature count: \"\n","        f\"{model_n_features}\"\n","    )\n","\n","\n","    if (\n","        model_n_features\n","        != N_FEATURES\n","    ):\n","\n","        raise ValueError(\n","            f\"Model expects \"\n","            f\"{model_n_features} predictors, \"\n","            f\"but exactly {N_FEATURES} are required.\"\n","        )\n","\n","\n","    print(\n","        \"✓ Model expects exactly \"\n","        \"33 predictors.\"\n","    )\n","\n","\n","# ============================================================\n","# 17. DETERMINE ACTUAL MODEL ORDER\n","# ============================================================\n","\n","MODEL_FEATURE_ORDER = (\n","    determine_model_feature_order(\n","        model,\n","        model_metadata,\n","    )\n",")\n","\n","\n","print(\"\\n\")\n","print(\n","    \"=\" * 80\n",")\n","\n","print(\n","    \"MODEL FEATURE ORDER\"\n",")\n","\n","print(\n","    \"=\" * 80\n",")\n","\n","\n","for index, feature in enumerate(\n","    MODEL_FEATURE_ORDER,\n","    start=1,\n","):\n","\n","    print(\n","        f\"Model column \"\n","        f\"{index:02d} \"\n","        f\"→ {feature}\"\n","    )\n","\n","\n","# ============================================================\n","# 18. INSPECT RASTER + BUILD MAPPING\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\n","    \"=\" * 80\n",")\n","\n","print(\n","    \"RASTER INFORMATION AND FEATURE ALIGNMENT\"\n",")\n","\n","print(\n","    \"=\" * 80\n",")\n","\n","\n","with rasterio.open(\n","    RASTER_PATH\n",") as src:\n","\n","\n","    print(\n","        f\"\\nRaster:\\n\"\n","        f\"{RASTER_PATH}\"\n","    )\n","\n","    print(\n","        f\"\\nDriver:      \"\n","        f\"{src.driver}\"\n","    )\n","\n","    print(\n","        f\"Width:       \"\n","        f\"{src.width:,}\"\n","    )\n","\n","    print(\n","        f\"Height:      \"\n","        f\"{src.height:,}\"\n","    )\n","\n","    print(\n","        f\"Bands:       \"\n","        f\"{src.count}\"\n","    )\n","\n","    print(\n","        f\"CRS:         \"\n","        f\"{src.crs}\"\n","    )\n","\n","    print(\n","        f\"Resolution:  \"\n","        f\"{src.res}\"\n","    )\n","\n","    print(\n","        f\"NoData:      \"\n","        f\"{src.nodata}\"\n","    )\n","\n","    print(\n","        f\"Extent:      \"\n","        f\"{src.bounds}\"\n","    )\n","\n","\n","    (\n","        MODEL_RASTER_BAND_INDICES,\n","        physical_raster_order,\n","    ) = resolve_raster_band_indices(\n","        src,\n","        MODEL_FEATURE_ORDER,\n","    )\n","\n","\n","    # ========================================================\n","    # PRINT EXACT MAPPING\n","    # ========================================================\n","\n","    print(\n","        \"\\n\"\n","        + \"-\" * 80\n","    )\n","\n","    print(\n","        \"EXACT MODEL ↔ RASTER ALIGNMENT\"\n","    )\n","\n","    print(\n","        \"-\" * 80\n","    )\n","\n","\n","    print(\n","        f\"{'Model col':<12}\"\n","        f\"{'Feature':<10}\"\n","        f\"{'Raster band':<14}\"\n","    )\n","\n","\n","    print(\n","        \"-\" * 40\n","    )\n","\n","\n","    for model_column, (\n","        feature,\n","        raster_band,\n","    ) in enumerate(\n","\n","        zip(\n","            MODEL_FEATURE_ORDER,\n","            MODEL_RASTER_BAND_INDICES,\n","        ),\n","\n","        start=1,\n","    ):\n","\n","        print(\n","            f\"{model_column:<12}\"\n","            f\"{feature:<10}\"\n","            f\"{raster_band:<14}\"\n","        )\n","\n","\n","    print(\n","        \"\\n✓ All 33 raster predictors \"\n","        \"will be read in MODEL order.\"\n","    )\n","\n","\n","# ============================================================\n","# 19. NUMBER OF WINDOWS\n","# ============================================================\n","\n","with rasterio.open(\n","    RASTER_PATH\n",") as src:\n","\n","    n_cols = math.ceil(\n","        src.width\n","        / WINDOW_SIZE\n","    )\n","\n","\n","    n_rows = math.ceil(\n","        src.height\n","        / WINDOW_SIZE\n","    )\n","\n","\n","    TOTAL_WINDOWS = (\n","        n_cols\n","        * n_rows\n","    )\n","\n","\n","print(\"\\n\")\n","print(\n","    \"=\" * 80\n",")\n","\n","print(\n","    \"PROCESSING CONFIGURATION\"\n",")\n","\n","print(\n","    \"=\" * 80\n",")\n","\n","\n","print(\n","    f\"\\nWindow size:       \"\n","    f\"{WINDOW_SIZE} x {WINDOW_SIZE}\"\n",")\n","\n","print(\n","    f\"Horizontal windows: \"\n","    f\"{n_cols}\"\n",")\n","\n","print(\n","    f\"Vertical windows:   \"\n","    f\"{n_rows}\"\n",")\n","\n","print(\n","    f\"Total windows:      \"\n","    f\"{TOTAL_WINDOWS:,}\"\n",")\n","\n","print(\n","    f\"Prediction batch:   \"\n","    f\"{PREDICTION_BATCH_SIZE:,} pixels\"\n",")\n","\n","print(\n","    f\"Output NoData:      \"\n","    f\"{OUTPUT_NODATA}\"\n",")\n","\n","\n","# ============================================================\n","# 20. RESUME / RESTART LOGIC\n","# ============================================================\n","\n","checkpoint = (\n","    load_checkpoint()\n","    if RESUME\n","    else None\n",")\n","\n","\n","start_window = 0\n","\n","\n","# ------------------------------------------------------------\n","# Explicit restart\n","# ------------------------------------------------------------\n","\n","if OVERWRITE_OUTPUT:\n","\n","    print(\n","        \"\\nOVERWRITE_OUTPUT=True\"\n","    )\n","\n","    print(\n","        \"Removing existing output \"\n","        \"and checkpoint.\"\n","    )\n","\n","\n","    if os.path.exists(\n","        OUTPUT_RASTER\n","    ):\n","\n","        os.remove(\n","            OUTPUT_RASTER\n","        )\n","\n","\n","    if os.path.exists(\n","        CHECKPOINT_PATH\n","    ):\n","\n","        os.remove(\n","            CHECKPOINT_PATH\n","        )\n","\n","\n","    checkpoint = None\n","\n","\n","# ------------------------------------------------------------\n","# Resume\n","# ------------------------------------------------------------\n","\n","elif checkpoint is not None:\n","\n","\n","    if (\n","        checkpoint.get(\n","            \"raster_path\"\n","        )\n","        != RASTER_PATH\n","    ):\n","\n","        raise ValueError(\n","            \"Checkpoint belongs to \"\n","            \"a different raster.\"\n","        )\n","\n","\n","    if (\n","        checkpoint.get(\n","            \"model_path\"\n","        )\n","        != MODEL_PATH\n","    ):\n","\n","        raise ValueError(\n","            \"Checkpoint belongs to \"\n","            \"a different model.\"\n","        )\n","\n","\n","    if (\n","        checkpoint.get(\n","            \"model_feature_order\"\n","        )\n","        != MODEL_FEATURE_ORDER\n","    ):\n","\n","        raise ValueError(\n","            \"Checkpoint model feature order \"\n","            \"differs from current order.\"\n","        )\n","\n","\n","    if (\n","        checkpoint.get(\n","            \"raster_band_indices\"\n","        )\n","        != MODEL_RASTER_BAND_INDICES\n","    ):\n","\n","        raise ValueError(\n","            \"Checkpoint raster-band mapping \"\n","            \"differs from current mapping.\"\n","        )\n","\n","\n","    if not output_raster_is_valid(\n","        OUTPUT_RASTER\n","    ):\n","\n","        print(\n","            \"\\nExisting output is invalid.\"\n","        )\n","\n","        print(\n","            \"Removing invalid raster \"\n","            \"and starting again.\"\n","        )\n","\n","\n","        if os.path.exists(\n","            OUTPUT_RASTER\n","        ):\n","\n","            os.remove(\n","                OUTPUT_RASTER\n","            )\n","\n","\n","        if os.path.exists(\n","            CHECKPOINT_PATH\n","        ):\n","\n","            os.remove(\n","                CHECKPOINT_PATH\n","            )\n","\n","\n","        checkpoint = None\n","\n","        start_window = 0\n","\n","\n","    else:\n","\n","        start_window = int(\n","            checkpoint.get(\n","                \"next_window\",\n","                0,\n","            )\n","        )\n","\n","\n","        print(\"\\n\")\n","        print(\n","            \"=\" * 80\n","        )\n","\n","        print(\n","            \"RESUMING PREVIOUS PREDICTION\"\n","        )\n","\n","        print(\n","            \"=\" * 80\n","        )\n","\n","\n","        print(\n","            f\"\\nCompleted windows: \"\n","            f\"{start_window:,}\"\n","        )\n","\n","        print(\n","            f\"Next window: \"\n","            f\"{start_window + 1:,}\"\n","        )\n","\n","\n","# ------------------------------------------------------------\n","# Existing output but no checkpoint\n","# ------------------------------------------------------------\n","\n","elif os.path.exists(\n","    OUTPUT_RASTER\n","):\n","\n","    if not output_raster_is_valid(\n","        OUTPUT_RASTER\n","    ):\n","\n","        print(\n","            \"\\nExisting output is not \"\n","            \"a valid GeoTIFF.\"\n","        )\n","\n","        print(\n","            \"Removing it automatically.\"\n","        )\n","\n","\n","        os.remove(\n","            OUTPUT_RASTER\n","        )\n","\n","\n","    else:\n","\n","        raise RuntimeError(\n","            \"\\nA valid output raster exists, \"\n","            \"but there is no checkpoint.\\n\\n\"\n","            \"If you want to regenerate it, set:\\n\"\n","            \"OVERWRITE_OUTPUT = True\"\n","        )\n","\n","\n","# ============================================================\n","# 21. OUTPUT PROFILE\n","# ============================================================\n","\n","with rasterio.open(\n","    RASTER_PATH\n",") as src:\n","\n","    output_profile = {\n","\n","        \"driver\":\n","            \"GTiff\",\n","\n","        \"width\":\n","            src.width,\n","\n","        \"height\":\n","            src.height,\n","\n","        \"count\":\n","            1,\n","\n","        \"dtype\":\n","            \"float32\",\n","\n","        \"crs\":\n","            src.crs,\n","\n","        \"transform\":\n","            src.transform,\n","\n","        \"nodata\":\n","            OUTPUT_NODATA,\n","\n","        \"compress\":\n","            \"DEFLATE\",\n","\n","        \"predictor\":\n","            3,\n","\n","        \"zlevel\":\n","            6,\n","\n","        \"tiled\":\n","            True,\n","\n","        \"blockxsize\":\n","            512,\n","\n","        \"blockysize\":\n","            512,\n","\n","        \"BIGTIFF\":\n","            \"YES\",\n","    }\n","\n","\n","# ============================================================\n","# 22. CREATE OUTPUT\n","# ============================================================\n","\n","if start_window == 0:\n","\n","    print(\"\\n\")\n","    print(\n","        \"=\" * 80\n","    )\n","\n","    print(\n","        \"CREATING OUTPUT SOC RASTER\"\n","    )\n","\n","    print(\n","        \"=\" * 80\n","    )\n","\n","\n","    with rasterio.open(\n","        OUTPUT_RASTER,\n","        \"w\",\n","        **output_profile,\n","    ) as dst:\n","\n","\n","        dst.set_band_description(\n","            1,\n","            \"Predicted_SOC_g_C_kg\"\n","        )\n","\n","\n","        dst.update_tags(\n","\n","            prediction=(\n","                \"Soil Organic Carbon\"\n","            ),\n","\n","            units=(\n","                \"g C kg-1\"\n","            ),\n","\n","            model=os.path.basename(\n","                MODEL_PATH\n","            ),\n","\n","            feature_count=(\n","                N_FEATURES\n","            ),\n","\n","            model_feature_order=(\n","                \",\".join(\n","                    MODEL_FEATURE_ORDER\n","                )\n","            ),\n","\n","            raster_band_indices=(\n","                \",\".join(\n","                    str(index)\n","                    for index\n","                    in MODEL_RASTER_BAND_INDICES\n","                )\n","            ),\n","        )\n","\n","\n","    print(\n","        f\"\\nOutput created:\\n\"\n","        f\"{OUTPUT_RASTER}\"\n","    )\n","\n","\n","# ============================================================\n","# 23. WALL-TO-WALL SOC PREDICTION\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\n","    \"=\" * 80\n",")\n","\n","print(\n","    \"STARTING WALL-TO-WALL SOC PREDICTION\"\n",")\n","\n","print(\n","    \"=\" * 80\n",")\n","\n","\n","print(\n","    \"\\nMODEL predictor order:\"\n",")\n","\n","print(\n","    \", \".join(\n","        MODEL_FEATURE_ORDER\n","    )\n",")\n","\n","\n","print(\n","    \"\\nRaster bands read in this order:\"\n",")\n","\n","print(\n","    MODEL_RASTER_BAND_INDICES\n",")\n","\n","\n","warnings.filterwarnings(\n","    \"ignore\",\n","    message=(\n","        \"X does not have valid feature names\"\n","    ),\n",")\n","\n","\n","with rasterio.open(\n","    RASTER_PATH\n",") as src, rasterio.open(\n","    OUTPUT_RASTER,\n","    \"r+\",\n",") as dst:\n","\n","\n","    windows = generate_windows(\n","        src.width,\n","        src.height,\n","        WINDOW_SIZE,\n","    )\n","\n","\n","    for window_index, window in enumerate(\n","        windows\n","    ):\n","\n","\n","        # ====================================================\n","        # RESUME\n","        # ====================================================\n","\n","        if (\n","            window_index\n","            < start_window\n","        ):\n","\n","            continue\n","\n","\n","        # ====================================================\n","        # READ 33 PREDICTORS\n","        #\n","        # CRITICAL:\n","        #\n","        # Data are now read in MODEL feature order,\n","        # NOT physical raster order.\n","        # ====================================================\n","\n","        data, masks = safe_read_window(\n","\n","            src=src,\n","\n","            band_indices=(\n","                MODEL_RASTER_BAND_INDICES\n","            ),\n","\n","            window=window,\n","        )\n","\n","\n","        bands, rows, cols = (\n","            data.shape\n","        )\n","\n","\n","        if bands != N_FEATURES:\n","\n","            raise RuntimeError(\n","                f\"Expected 33 predictors; \"\n","                f\"read {bands}.\"\n","            )\n","\n","\n","        # ====================================================\n","        # CONVERT:\n","        #\n","        # 33 × rows × cols\n","        #\n","        # to:\n","        #\n","        # pixels × 33\n","        #\n","        # Column order is already MODEL order.\n","        # ====================================================\n","\n","        X = (\n","\n","            data\n","\n","            .reshape(\n","                bands,\n","                -1,\n","            )\n","\