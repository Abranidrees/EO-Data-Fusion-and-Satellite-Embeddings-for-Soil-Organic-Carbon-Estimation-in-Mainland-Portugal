=\n","\n","RF\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/RF/grid_search_all_results.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/RF/best_10fold_metrics.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/RF/best_model.joblib\n","\n","GTB\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/GTB/grid_search_all_results.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/GTB/best_10fold_metrics.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/GTB/best_model.joblib\n","\n","CART\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/CART/grid_search_all_results.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/CART/best_10fold_metrics.csv\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/CART/best_model.joblib\n","\n","Overall summary\n","  /content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/2.Model_development/Dataset-I/independent_validation_summary.csv\n"]}]},{"cell_type":"markdown","source":["# Model Development (Dataset-II)"],"metadata":{"id":"VaeTNwRBRWBU"}},{"cell_type":"code","source":["# Optional Colab installation (run once if required):\n","# !pip install -q geopandas pyogrio scikit-learn joblib\n","\n","\"\"\"\n","Dataset-I SOC regression using RF, GTB, and CART.\n","\n","- Development data: fixed 10-fold, 20-km spatial cross-validation.\n","- Hyperparameters: selected by the lowest spatial-CV RMSE.\n","- Independent validation: used only after tuning and final fitting.\n","- Predictors: read only from the CSV column named ``feature``.\n","- No raster prediction is performed.\n","\n","Outputs for each model:\n","    grid_search_all_results.csv\n","    best_10fold_metrics.csv\n","    best_model.joblib\n","\n","Overall output:\n","    independent_validation_summary.csv\n","\"\"\"\n","\n","import json\n","import sys\n","import time\n","from pathlib import Path\n","\n","import geopandas as gpd\n","import joblib\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.base import clone\n","from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor\n","from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n","from sklearn.model_selection import GridSearchCV, GroupKFold, ParameterGrid\n","from sklearn.tree import DecisionTreeRegressor\n","\n","\n","# ============================================================\n","# USER SETTINGS\n","# ============================================================\n","\n","DEVELOPMENT_GPKG = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/1_Feature_Selection/Split_features/LUCAS_samples_GSE_train_test.gpkg\"\n",")\n","\n","INDEPENDENT_VALIDATION_GPKG = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/1_Feature_Selection/Split_features/LUCAS_samples_GSE_train_test.gpkg\"\n",")\n","\n","SELECTED_FEATURES_CSV = (\n","    \"/content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/1_Feature_Selection/RFECV_SOC_Dataset-II/best_RF_feature_importance.csv\"\n",")\n","\n","FEATURE_COLUMN = \"feature\"\n","TARGET_COLUMN = \"OC\"\n","\n","OUT_DIR = Path(\n","    \"/content/drive/MyDrive/1.SOC_Estimation/1.Final_SOC_estimation/\"\n","    \"2.Model_development/Dataset-II\"\n",")\n","\n","TARGET_CRS = \"EPSG:3763\"\n","N_SPATIAL_FOLDS = 10\n","SPATIAL_BLOCK_SIZE_M = 20_000\n","GRID_OFFSET_X_M = 0\n","GRID_OFFSET_Y_M = 0\n","RANDOM_SEED = 42\n","N_JOBS = -1\n","\n","# GridSearchCV is kept sequential so that Colab prints every fold immediately.\n","# Random Forest can still use all CPU cores internally through N_JOBS=-1.\n","GRID_SEARCH_N_JOBS = 1\n","GRID_SEARCH_VERBOSE = 3\n","\n","MAX_ALLOWED_COMBINATIONS_PER_MODEL = 500\n","ALLOW_LARGE_GRIDS = False\n","\n","\n","# ============================================================\n","# HYPERPARAMETER GRIDS\n","# ============================================================\n","\n","RF_PARAMETER_GRID = {\n","    \"n_estimators\": [500, 1000, 2000],\n","    \"max_depth\": [None, 20, 40],\n","    \"min_samples_leaf\": [1, 2, 5],\n","    \"max_features\": [\"sqrt\", 0.5, 1.0],\n","    \"bootstrap\": [True],\n","}\n","\n","GTB_PARAMETER_GRID = {\n","    \"n_estimators\": [100, 300, 500],\n","    \"learning_rate\": [0.03, 0.05, 0.10],\n","    \"subsample\": [0.7, 1.0],\n","    \"max_depth\": [2, 3, 5],\n","    \"min_samples_leaf\": [1, 5],\n","    \"loss\": [\"squared_error\", \"huber\"],\n","}\n","\n","CART_PARAMETER_GRID = {\n","    \"criterion\": [\"squared_error\", \"friedman_mse\"],\n","    \"max_depth\": [None, 10, 20, 30],\n","    \"max_leaf_nodes\": [32, 64, 128],\n","    \"min_samples_leaf\": [1, 2, 5, 10],\n","}\n","\n","\n","# ============================================================\n","# OUTPUTS\n","# ============================================================\n","\n","MODEL_OUTPUTS = {\n","    name: {\n","        \"folder\": OUT_DIR / name,\n","        \"grid\": OUT_DIR / name / \"grid_search_all_results.csv\",\n","        \"cv\": OUT_DIR / name / \"best_10fold_metrics.csv\",\n","        \"model\": OUT_DIR / name / \"best_model.joblib\",\n","    }\n","    for name in [\"RF\", \"GTB\", \"CART\"]\n","}\n","\n","OUT_INDEPENDENT_SUMMARY = OUT_DIR / \"independent_validation_summary.csv\"\n","\n","\n","# ============================================================\n","# HELPERS\n","# ============================================================\n","\n","def banner(message):\n","    print(\"\\n\" + \"=\" * 110)\n","    print(message)\n","    print(\"=\" * 110)\n","\n","\n","def step(message):\n","    \"\"\"Print a timestamped progress message immediately.\"\"\"\n","    print(\n","        f\"[{time.strftime('%H:%M:%S')}] {message}\",\n","        flush=True,\n","    )\n","    sys.stdout.flush()\n","\n","\n","def json_safe(value):\n","    if isinstance(value, np.integer):\n","        return int(value)\n","    if isinstance(value, np.floating):\n","        return float(value)\n","    if isinstance(value, np.bool_):\n","        return bool(value)\n","    if isinstance(value, dict):\n","        return {str(k): json_safe(v) for k, v in value.items()}\n","    if isinstance(value, (list, tuple)):\n","        return [json_safe(v) for v in value]\n","    return value\n","\n","\n","def count_combinations(grid):\n","    return len(list(ParameterGrid(grid)))\n","\n","\n","def validate_grid_size(name, grid):\n","    count = count_combinations(grid)\n","    if count > MAX_ALLOWED_COMBINATIONS_PER_MODEL and not ALLOW_LARGE_GRIDS:\n","        raise ValueError(\n","            f\"{name} has {count} combinations, exceeding \"\n","            f\"MAX_ALLOWED_COMBINATIONS_PER_MODEL=\"\n","            f\"{MAX_ALLOWED_COMBINATIONS_PER_MODEL}.\"\n","        )\n","    return count\n","\n","\n","def load_selected_features():\n","    path = Path(SELECTED_FEATURES_CSV)\n","    if not path.exists():\n","        raise FileNotFoundError(path)\n","\n","    df = pd.read_csv(path)\n","    if FEATURE_COLUMN not in df.columns:\n","        raise ValueError(\n","            f\"'{FEATURE_COLUMN}' not found. Available columns: \"\n","            f\"{df.columns.tolist()}\"\n","        )\n","\n","    features = (\n","        df[FEATURE_COLUMN]\n","        .dropna()\n","        .astype(str)\n","        .str.strip()\n","        .tolist()\n","    )\n","    features = [f for f in features if f]\n","    features = list(dict.fromkeys(features))\n","\n","    if not features:\n","        raise ValueError(\"No feature names were found in the CSV.\")\n","\n","    return features\n","\n","\n","def case_insensitive_lookup(columns):\n","    lookup = {}\n","    for column in columns:\n","        key = str(column).strip().casefold()\n","        if key in lookup:\n","            raise ValueError(\n","                f\"Duplicate column names under case-insensitive matching: \"\n","                f\"'{lookup[key]}' and '{column}'.\"\n","            )\n","        lookup[key] = column\n","    return lookup\n","\n","\n","def load_points(path, dataset_name, selected_features):\n","    path = Path(path)\n","    if not path.exists():\n","        raise FileNotFoundError(path)\n","\n","    gdf = gpd.read_file(path)\n","    if gdf.empty:\n","        raise ValueError(f\"{dataset_name} is empty.\")\n","    if gdf.crs is None:\n","        raise ValueError(f\"{dataset_name} has no CRS.\")\n","\n","    valid_geometry = (\n","        gdf.geometry.notna()\n","        & (~gdf.geometry.is_empty)\n","        & gdf.geometry.geom_type.eq(\"Point\")\n","    )\n","    removed = int((~valid_geometry).sum())\n","    if removed:\n","        step(f\"{dataset_name}: removed {removed} invalid geometries.\")\n","    gdf = gdf.loc[valid_geometry].copy()\n","\n","    lookup = case_insensitive_lookup(gdf.columns)\n","\n","    target_key = TARGET_COLUMN.casefold()\n","    if target_key not in lookup:\n","        raise ValueError(\n","            f\"{dataset_name} does not contain target '{TARGET_COLUMN}'.\"\n","        )\n","    actual_target = lookup[target_key]\n","    if actual_target != TARGET_COLUMN:\n","        gdf = gdf.rename(columns={actual_target: TARGET_COLUMN})\n","\n","    lookup = case_insensitive_lookup(gdf.columns)\n","    rename_map = {}\n","    missing = []\n","\n","    for feature in selected_features:\n","        key = feature.casefold()\n","        if key not in lookup:\n","            missing.append(feature)\n","        elif lookup[key] != feature:\n","            rename_map[lookup[key]] = feature\n","\n","    if missing:\n","        raise ValueError(\n","            f\"{dataset_name} is missing selected predictors:\\n\"\n","            + \"\\n\".join(f\"  - {f}\" for f in missing)\n","        )\n","\n","    if rename_map:\n","        gdf = gdf.rename(columns=rename_map)\n","\n","    if gdf.crs.to_epsg() != 3763:\n","        step(f\"{dataset_name}: reprojecting to {TARGET_CRS}.\")\n","        gdf = gdf.to_crs(TARGET_CRS)\n","\n","    required = [TARGET_COLUMN, *selected_features]\n","    for column in required:\n","        gdf[column] = pd.to_numeric(gdf[column], errors=\"coerce\")\n","\n","    gdf[required] = gdf[required].replace([np.inf, -np.inf], np.nan)\n","    before = len(gdf)\n","    gdf = gdf.dropna(subset=required).copy()\n","    removed = before - len(gdf)\n","    if removed:\n","        step(f\"{dataset_name}: removed {removed} incomplete rows.\")\n","\n","    if gdf.empty:\n","        raise ValueError(f\"No complete rows remain in {dataset_name}.\")\n","\n","    return gdf.reset_index(drop=True)\n","\n","\n","def build_spatial_groups(gdf):\n","    block_x = np.floor(\n","        (gdf.geometry.x.to_numpy() - GRID_OFFSET_X_M)\n","        / SPATIAL_BLOCK_SIZE_M\n","    ).astype(np.int64)\n","\n","    block_y = np.floor(\n","        (gdf.geometry.y.to_numpy() - GRID_OFFSET_Y_M)\n","        / SPATIAL_BLOCK_SIZE_M\n","    ).astype(np.int64)\n","\n","    groups = np.char.add(\n","        np.char.add(block_x.astype(str), \"_\"),\n","        block_y.astype(str),\n","    )\n","\n","    n_groups = pd.Series(groups).nunique()\n","    if n_groups < N_SPATIAL_FOLDS:\n","        raise ValueError(\n","            f\"Only {n_groups} unique spatial blocks were found, but \"\n","            f\"{N_SPATIAL_FOLDS} folds were requested.\"\n","        )\n","\n","    return groups\n","\n","\n","def regression_metrics(y_true, y_pred):\n","    y_true = np.asarray(y_true, dtype=np.float64)\n","    y_pred = np.asarray(y_pred, dtype=np.float64)\n","\n","    rmse = float(np.sqrt(mean_squared_error(y_true, y_pred)))\n","    mae = float(mean_absolute_error(y_true, y_pred))\n","    r2 = (\n","        float(r2_score(y_true, y_pred))\n","        if len(y_true) >= 2 and np.var(y_true) > 0\n","        else np.nan\n","    )\n","\n","    q25, q75 = np.percentile(y_true, [25, 75])\n","    iqr = float(q75 - q25)\n","    rpiq = float(iqr / rmse) if rmse > 0 else np.nan\n","\n","    return {\n","        \"R2\": r2,\n","        \"RMSE\": rmse,\n","        \"MAE\": mae,\n","        \"RPIQ\": rpiq,\n","        \"Observed_Q25\": float(q25),\n","        \"Observed_Q75\": float(q75),\n","        \"Observed_IQR\": iqr,\n","    }\n","\n","\n","def model_specs():\n","    return {\n","        \"RF\": {\n","            \"estimator\": RandomForestRegressor(\n","                random_state=RANDOM_SEED,\n","                n_jobs=N_JOBS,\n","            ),\n","            \"grid\": RF_PARAMETER_GRID,\n","        },\n","        \"GTB\": {\n","            \"estimator\": GradientBoostingRegressor(\n","                random_state=RANDOM_SEED,\n","            ),\n","            \"grid\": GTB_PARAMETER_GRID,\n","        },\n","        \"CART\": {\n","            \"estimator\": DecisionTreeRegressor(\n","                random_state=RANDOM_SEED,\n","            ),\n","            \"grid\": CART_PARAMETER_GRID,\n","        },\n","    }\n","\n","\n","SCORING = {\n","    \"R2\": \"r2\",\n","    \"RMSE\": \"neg_root_mean_squared_error\",\n","    \"MAE\": \"neg_mean_absolute_error\",\n","}\n","\n","\n","def run_grid_search(name, estimator, grid, X, y, groups, cv):\n","    \"\"\"\n","    Run one grid search with live fold-by-fold progress.\n","\n","    GRID_SEARCH_N_JOBS=1 is intentional: sklearn then prints every completed\n","    fit immediately instead of buffering messages from parallel workers.\n","    \"\"\"\n","    combinations = validate_grid_size(name, grid)\n","    total_fits = combinations * N_SPATIAL_FOLDS\n","\n","    banner(\n","        f\"{name}: {combinations} COMBINATIONS × \"\n","        f\"{N_SPATIAL_FOLDS} SPATIAL FOLDS\"\n","    )\n","\n","    step(f\"{name}: total model fits to complete = {total_fits:,}\")\n","    step(\n","        f\"{name}: live progress enabled \"\n","        f\"(GridSearchCV n_jobs={GRID_SEARCH_N_JOBS}, \"\n","        f\"verbose={GRID_SEARCH_VERBOSE})\"\n","    )\n","    step(\n","        f\"{name}: Random Forest tree-level parallelism remains \"\n","        f\"N_JOBS={N_JOBS}\"\n","    )\n","\n","    print(\"\\nParameter grid:\", flush=True)\n","    for parameter, values in grid.items():\n","        print(\n","            f\"  {parameter}: {values}\",\n","            flush=True,\n","        )\n","\n","    print(\n","        \"\\nEach completed fit will be printed by sklearn in this form:\\n\"\n","        \"  [CV fold/total] END parameter values; scores; total time\\n\",\n","        flush=True,\n","    )\n","\n","    search = GridSearchCV(\n","        estimator=estimator,\n","        param_grid=grid,\n","        scoring=SCORING,\n","        refit=\"RMSE\",\n","        cv=cv,\n","        n_jobs=GRID_SEARCH_N_JOBS,\n","        verbose=GRID_SEARCH_VERBOSE,\n","        return_train_score=False,\n","        error_score=\"raise\",\n","        pre_dispatch=1,\n","    )\n","\n","    start = time.time()\n","    step(f\"{name}: grid search started.\")\n","\n","    search.fit(X, y, groups=groups)\n","\n","    runtime_seconds = time.time() - start\n","    runtime_minutes = runtime_seconds / 60\n","\n","    step(\n","        f\"{name}: grid search completed: \"\n","        f\"{total_fits:,}/{total_fits:,} fits finished.\"\n","    )\n","    step(\n","        f\"{name}: total search runtime = \"\n","        f\"{runtime_minutes:.2f} minutes \"\n","        f\"({runtime_seconds / 3600:.2f} hours).\"\n","    )\n","\n","    results = pd.DataFrame(search.cv_results_)\n","    results[\"mean_CV_RMSE\"] = -results[\"mean_test_RMSE\"]\n","    results[\"std_CV_RMSE\"] = results[\"std_test_RMSE\"]\n","    results[\"mean_CV_MAE\"] = -results[\"mean_test_MAE\"]\n","    results[\"std_CV_MAE\"] = results[\"std_test_MAE\"]\n","    results[\"mean_CV_R2\"] = results[\"mean_test_R2\"]\n","    results[\"std_CV_R2\"] = results[\"std_test_R2\"]\n","\n","    results = results.sort_values(\n","        [\"rank_test_RMSE\", \"mean_CV_RMSE\", \"mean_CV_MAE\"],\n","        ascending=[True, True, True],\n","    ).reset_index(drop=True)\n","\n","    results.insert(0, \"algorithm\", name)\n","    results.insert(1, \"fixed_spatial_folds\", N_SPATIAL_FOLDS)\n","    results.insert(2, \"fixed_block_size_m\", SPATIAL_BLOCK_SIZE_M)\n","    results.insert(3, \"search_runtime_minutes\", runtime_minutes)\n","\n","    step(f\"{name}: best CV RMSE = {-search.best_score_:.6f}\")\n","    step(f\"{name}: best parameters = {search.best_params_}\")\n","\n","    return search, results, runtime_minutes\n","\n","\n","def best_model_10fold_metrics(name, best_estimator, X, y, groups, cv):\n","    oof = np.full(len(y), np.nan, dtype=np.float64)\n","    rows = []\n","\n","    total_folds = N_SPATIAL_FOLDS\n","    cv_start = time.time()\n","\n","    step(\n","        f\"{name}: starting explicit evaluation of the best model \"\n","        f\"across {total_folds} spatial folds.\"\n","    )\n","\n","    for fold, (train_idx, test_idx) in enumerate(\n","        cv.split(X, y, groups),\n","        start=1,\n","    ):\n","        fold_start = time.time()\n","        percent_before = 100.0 * (fold - 1) / total_folds\n","\n","        step(\n","            f\"{name}: best-model CV fold {fold}/{total_folds} \"\n","            f\"started ({percent_before:.1f}% complete) | \"\n","            f\"train={len(train_idx)}, test={len(test_idx)}\"\n","        )\n","\n","        train_groups = set(groups[train_idx].tolist())\n","        test_groups = set(groups[test_idx].tolist())\n","        if train_groups.intersection(test_groups):\n","            raise RuntimeError(f\"{name} fold {fold} has group leakage.\")\n","\n","        model = clone(best_estimator)\n","        model.fit(X.iloc[train_idx], y[train_idx])\n","        pred = model.predict(X.iloc[test_idx])\n","        oof[test_idx] = pred\n","\n","        fold_metrics = regression_metrics(\n","            y[test_idx],\n","            pred,\n","        )\n","\n","        rows.append({\n","            \"row_type\": \"FOLD\",\n","            \"fold\": fold,\n","            \"n_train\": len(train_idx),\n","            \"n_test\": len(test_idx),\n","            \"n_train_blocks\": len(train_groups),\n","            \"n_test_blocks\": len(test_groups),\n","            **fold_metrics,\n","        })\n","\n","        fold_seconds = time.time() - fold_start\n","        percent_after = 100.0 * fold / total_folds\n","        elapsed_seconds = time.time() - cv_start\n","        average_seconds = elapsed_seconds / fold\n","        remaining_seconds = average_seconds * (total_folds - fold)\n","\n","        step(\n","            f\"{name}: best-model CV fold {fold}/{total_folds} completed \"\n","            f\"({percent_after:.1f}%) | \"\n","            f\"R2={fold_metrics['R2']:.5f}, \"\n","            f\"RMSE={fold_metrics['RMSE']:.5f}, \"\n","            f\"MAE={fold_metrics['MAE']:.5f}, \"\n","            f\"RPIQ={fold_metrics['RPIQ']:.5f} | \"\n","            f\"fold time={fold_seconds / 60:.2f} min | \"\n","            f\"estimated remaining={remaining_seconds / 60:.2f} min\"\n","        )\n","\n","    if np.isnan(oof).any():\n","        raise RuntimeError(f\"{name}: incomplete out-of-fold predictions.\")\n","\n","    fold_df = pd.DataFrame(rows)\n","    metrics = [\n","        \"R2\", \"RMSE\", \"MAE\", \"RPIQ\",\n","        \"Observed_Q25\", \"Observed_Q75\", \"Observed_IQR\",\n","    ]\n","\n","    mean_row = {\n","        \"row_type\": \"FOLD_MEAN\",\n","        \"fold\": np.nan,\n","        \"n_train\": fold_df[\"n_train\"].mean(),\n","        \"n_test\": fold_df[\"n_test\"].mean(),\n","        \"n_train_blocks\": fold_df[\"n_train_blocks\"].mean(),\n","        \"n_test_blocks\": fold_df[\"n_test_blocks\"].mean(),\n","    }\n","    std_row = {\n","        \"row_type\": \"FOLD_STD\",\n","        \"fold\": np.nan,\n","        \"n_train\": fold_df[\"n_train\"].std(ddof=1),\n","        \"n_test\": fold_df[\"n_test\"].std(ddof=1),\n","        \"n_train_blocks\": fold_df[\"n_train_blocks\"].std(ddof=1),\n","        \"n_test_blocks\": fold_df[\"n_test_blocks\"].std(ddof=1),\n","    }\n","\n","    for metric in metrics:\n","        mean_row[metric] = fold_df[metric].mean()\n","        std_row[metric] = fold_df[metric].std(ddof=1)\n","\n","    overall = regression_metrics(y, oof)\n","    overall_row = {\n","        \"row_type\": \"OOF_OVERALL\",\n","        \"fold\": np.nan,\n","        \"n_train\": np.nan,\n","        \"n_test\": len(y),\n","        \"n_train_blocks\": np.nan,\n","        \"n_test_blocks\": pd.Series(groups).nunique(),\n","        **overall,\n","    }\n","\n","    output = pd.concat(\n","        [\n","            fold_df,\n","            pd.DataFrame([mean_row, std_row, overall_row]),\n","        ],\n","        ignore_index=True,\n","    )\n","\n","    return output, overall\n","\n","\n","# ============================================================\n","# MAIN\n","# ============================================================\n","\n","def main():\n","    OUT_DIR.mkdir(parents=True, exist_ok=True)\n","    for paths in MODEL_OUTPUTS.values():\n","        paths[\"folder\"].mkdir(parents=True, exist_ok=True)\n","\n","    banner(\"1. LOAD RFECV-SELECTED DATASET-I FEATURES\")\n","    selected_features = load_selected_features()\n","    print(f\"Selected features: {len(selected_features)}\")\n","    for i, feature in enumerate(selected_features, start=1):\n","        print(f\"  {i:>3}. {feature}\")\n","\n","    banner(\"2. LOAD DEVELOPMENT AND INDEPENDENT VALIDATION POINTS\")\n","    development = load_points(\n","        DEVELOPMENT_GPKG,\n","        \"Development dataset\",\n","        selected_features,\n","    )\n","    validation = load_points(\n","        INDEPENDENT_VALIDATION_GPKG,\n","        \"Independent validation dataset\",\n","        selected_features,\n","    )\n","\n","    X_dev = development[selected_features].copy()\n","    y_dev = development[TARGET_COLUMN].to_numpy(dtype=np.float64)\n","    X_val = validation[selected_features].copy()\n","    y_val = validation[TARGET_COLUMN].to_numpy(dtype=np.float64)\n","\n","    groups = build_spatial_groups(development)\n","    cv = GroupKFold(n_splits=N_SPATIAL_FOLDS)\n","\n","    print(f\"Development points: {len(development)}\")\n","    print(f\"Independent validation points: {len(validation)}\")\n","    print(f\"Predictors: {len(selected_features)}\")\n","    print(f\"Spatial blocks: {pd.Series(groups).nunique()}\")\n","\n","    independent_rows = []\n","\n","    specifications = model_specs()\n","    total_algorithms = len(specifications)\n","\n","    for algorithm_number, (name, spec) in enumerate(\n","        specifications.items(),\n","        start=1,\n","    ):\n","        banner(\n","            f\"ALGORITHM {algorithm_number}/{total_algorithms}: {name}\"\n","        )\n","        step(\n","            f\"Overall workflow progress: starting {name} \"\n","            f\"({algorithm_number}/{total_algorithms}).\"\n","        )\n","\n","        search, grid_results, runtime = run_grid_search(\n","            name,\n","            spec[\"estimator\"],\n","            spec[\"grid\"],\n","            X_dev,\n","            y_dev,\n","            groups,\n","            cv,\n","        )\n","        grid_results.to_csv(MODEL_OUTPUTS[name][\"grid\"], index=False)\n","        step(\n","            f\"{name}: saved complete grid results to \"\n","            f\"{MODEL_OUTPUTS[name]['grid']}\"\n","        )\n","\n","        cv_metrics_df, oof_metrics = best_model_10fold_metrics(\n","            name,\n","            search.best_estimator_,\n","            X_dev,\n","            y_dev,\n","            groups,\n","            cv,\n","        )\n","        cv_metrics_df.to_csv(MODEL_OUTPUTS[name][\"cv\"], index=False)\n","        step(\n","            f